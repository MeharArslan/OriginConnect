<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar android:id="@+id/profileToolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">

            <!-- Avatar -->
            <FrameLayout android:layout_width="96dp" android:layout_height="96dp"
                android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp">
                <ImageView android:id="@+id/imgProfileAvatar"
                    android:layout_width="96dp" android:layout_height="96dp"
                    android:src="@drawable/ic_person" android:scaleType="centerCrop"
                    android:background="@color/oc_surface" android:padding="16dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Tap to change" android:textSize="11sp"
                    android:textColor="#CCFFFFFF" android:gravity="center"
                    android:background="#80000000"
                    android:layout_gravity="bottom" android:padding="4dp"/>
            </FrameLayout>

            <!-- Phone (read only) -->
            <TextView android:id="@+id/tvProfilePhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="?android:textColorSecondary"
                android:gravity="center" android:layout_marginBottom="24dp"/>

            <!-- Name -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/OcOutlinedField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Your name" android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="?android:textColorPrimary" android:maxLength="50"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- About presets -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="About" android:textSize="13sp"
                android:textColor="@color/oc_primary" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinnerAbout"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>

            <!-- Custom about -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/OcOutlinedField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Custom about" android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileAbout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine" android:maxLines="3"
                    android:textColor="?android:textColorPrimary" android:maxLength="100"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar android:id="@+id/profileProgress"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="Save" android:background="@drawable/bg_btn_primary"
                android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
