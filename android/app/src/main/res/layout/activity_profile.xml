<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <androidx.appcompat.widget.Toolbar android:id="@+id/profileToolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <!-- Avatar with edit overlay -->
            <FrameLayout android:layout_width="96dp" android:layout_height="96dp"
                android:layout_gravity="center_horizontal" android:layout_marginBottom="4dp">
                <ImageView android:id="@+id/imgProfileAvatar"
                    android:layout_width="96dp" android:layout_height="96dp"
                    android:src="@drawable/ic_person" android:scaleType="centerCrop"
                    android:background="@color/oc_surface" android:padding="16dp"/>
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#66000000"/>
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center" android:src="@drawable/ic_camera"/>
            </FrameLayout>
            <!-- Camera / Gallery -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                <TextView android:id="@+id/tvCameraOption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Camera" android:textColor="@color/oc_primary"
                    android:textSize="13sp" android:padding="8dp"
                    android:background="?attr/selectableItemBackground"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  |  " android:textColor="?android:textColorSecondary" android:textSize="13sp"/>
                <TextView android:id="@+id/tvGalleryOption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gallery" android:textColor="@color/oc_primary"
                    android:textSize="13sp" android:padding="8dp"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
            <!-- Phone (read only) -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Phone Number" android:textSize="12sp"
                android:textColor="@color/oc_primary" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/tvProfilePhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="16sp" android:textColor="?android:textColorSecondary"
                android:layout_marginBottom="20dp" android:paddingStart="4dp"/>
            <!-- Name -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/OcOutlinedField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Your name" android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="?android:textColorPrimary" android:maxLength="50"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!-- About preset -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="About" android:textSize="12sp"
                android:textColor="@color/oc_primary" android:layout_marginBottom="4dp"/>
            <Spinner android:id="@+id/spinnerAbout"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>
            <!-- Custom about -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/OcOutlinedField"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Custom about text" android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfileAbout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine" android:maxLines="3"
                    android:textColor="?android:textColorPrimary" android:maxLength="100"
                    android:enabled="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <ProgressBar android:id="@+id/profileProgress"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="Save Profile"
                android:background="@drawable/bg_btn_primary"
                android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
